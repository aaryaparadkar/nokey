# Copy to .env and adjust. All values have dev defaults except SESSION_SECRET in production.
PORT=3000
# Relying Party ID: your domain without scheme/port (e.g. nokey.dev). "localhost" for dev.
RP_ID=localhost
RP_NAME=nokey
# Exact origin(s) the browser runs the frontend on, comma-separated. Must be https
# (or http://localhost) and its host must equal RP_ID or be a subdomain of it.
ORIGIN=http://localhost:5173
# >= 32 chars. Generate: openssl rand -base64 48
SESSION_SECRET=
DATABASE_PATH=./data/nokey.db
# Set to true only behind a reverse proxy that sets X-Forwarded-For (Fly, Railway, nginx).
# Used for per-IP rate limiting of sign-in endpoints.
TRUST_PROXY=false
