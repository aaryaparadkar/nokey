{
  "name": "nokey",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run --filter '@nokey/{server,web}' dev",
    "dev:server": "bun run --filter @nokey/server dev",
    "dev:web": "bun run --filter @nokey/web dev",
    "build": "bun run --filter @nokey/web build",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
